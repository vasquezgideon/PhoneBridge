[Unit]
Description=PhoneBridge Pi: USB serial gadget for the Chromebook
DefaultDependencies=no
After=sys-kernel-config.mount systemd-modules-load.service
Before=phonebridge.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/phonebridge/gadget.sh

[Install]
WantedBy=multi-user.target
